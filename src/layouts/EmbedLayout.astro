---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Build Yardage Construction Calculator Widget', lang = 'en' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} class="h-full bg-canvas">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full bg-canvas text-ink antialiased p-2 sm:p-4 selection:bg-brand-accent selection:text-white">
    <slot />
  </body>
</html>
