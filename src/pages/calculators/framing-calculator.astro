---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FramingCalculator from '../../components/FramingCalculator.tsx';
import ToolGuideSection from '../../components/ToolGuideSection.astro';
import materials from '../../data/materials.json';
import { STANDARDS_CITATIONS } from '../../utils/constants';

const item = materials.find(m => m.slug === 'framing-calculator')!;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": item.meta_title,
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "description": item.meta_description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout 
  title={item.meta_title} 
  description={item.meta_description}
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="no-print print:hidden bg-canvas border-b border-hairline transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-accent/10 text-brand-accent dark:text-indigo-400 text-xs font-semibold mb-4">
          <span class="flex h-2 w-2 rounded-full bg-brand-accent animate-pulse"></span>
          <span>100% Free Contractor Tool</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          {item.material} <span class="text-brand-accent">{item.shape}</span> Calculator
        </h1>
        <p class="mt-3 text-md text-muted leading-relaxed">
          Get highly precise calculations for your next construction or DIY project. Enter your jobsite measurements below for instant yards, tonnage, plates, or bag estimates.
        </p>
      </div>
      
      <!-- Quick Info Badges -->
      <div class="flex flex-wrap gap-3 justify-center md:justify-end shrink-0">
        <div class="bg-surface-card border border-hairline px-4 py-3 rounded-lg flex flex-col items-center min-w-[100px]">
          <span class="text-[10px] font-bold uppercase text-muted tracking-wider">Precision</span>
          <span class="text-sm font-mono font-extrabold text-ink mt-0.5">High</span>
        </div>
        <div class="bg-surface-card border border-hairline px-4 py-3 rounded-lg flex flex-col items-center min-w-[100px]">
          <span class="text-[10px] font-bold uppercase text-muted tracking-wider">Standard</span>
          <span class="text-sm font-mono font-extrabold text-ink mt-0.5">{STANDARDS_CITATIONS.FRAMING}</span>
        </div>
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-embed-modal'))"
          class="bg-brand-accent/10 border border-brand-accent/30 hover:border-brand-accent hover:bg-brand-accent/20 text-brand-accent dark:text-indigo-400 px-4 py-3 rounded-lg flex flex-col items-center min-w-[110px] transition-all cursor-pointer group active:scale-95 shadow-sm"
          title="Embed this calculator widget on your website"
        >
          <span class="text-[10px] font-extrabold uppercase tracking-wider text-brand-accent flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            Widget
          </span>
          <span class="text-sm font-bold text-ink group-hover:text-brand-accent transition-colors mt-0.5">
            Embed &lt;/&gt;
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Component -->
  <div class="bg-canvas/50 transition-colors duration-200">
    <FramingCalculator client:load  locale="en" />
  </div>

  <!-- Tool Specific Guide Section -->
  <ToolGuideSection slug={item.slug} />
</BaseLayout>
