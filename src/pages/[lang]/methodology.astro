---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SUPPORTED_LOCALES, getTranslations, getLocalizedPath, type SupportedLocale } from '../../i18n/utils';
import { Scale } from 'lucide-react';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((l) => l !== 'en').map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const activeLang = (lang || 'es') as SupportedLocale;
const t = getTranslations(activeLang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `${t.methodologyPage.title} - Build Yardage`,
  "url": `https://buildyardage.com/${activeLang}/methodology`,
  "description": t.methodologyPage.subtitle
};
---

<BaseLayout
  title={t.methodologyPage.title}
  description={t.methodologyPage.subtitle}
  jsonLd={jsonLd}
  lang={activeLang}
>
  <!-- Header Banner -->
  <section class="bg-canvas border-b border-hairline py-12 sm:py-16 transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex text-xs text-muted mb-4 gap-2">
        <a href={getLocalizedPath('/', activeLang)} class="hover:text-ink">{t.common.home}</a>
        <span>/</span>
        <span class="text-brand-accent font-semibold">{t.methodologyPage.title}</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink tracking-tight mb-3 max-w-3xl">
        {t.methodologyPage.title}
      </h1>
      <p class="text-xs sm:text-sm text-muted">
        Last Updated: July 25, 2026 • BuildYardage.com
      </p>
    </div>
  </section>

  <!-- Legal/Methodology Body Content -->
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="bg-canvas border border-hairline rounded-xl p-8 sm:p-12 space-y-10 text-sm text-body leading-relaxed">
      
      <div class="flex items-center gap-3 border-b border-hairline pb-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-accent/10 text-brand-accent">
          <Scale size={22} />
        </div>
        <div>
          <h2 class="text-lg font-bold text-ink">Governing Calculation Standards</h2>
          <p class="text-xs text-muted">{t.methodologyPage.subtitle}</p>
        </div>
      </div>

      <!-- 1. Concrete Volume -->
      <div class="space-y-4">
        <h2 class="text-lg font-bold text-ink">1. {t.methodologyPage.concreteTitle}</h2>
        <p>
          <strong>{t.methodologyPage.methodologyLabel}</strong> {t.methodologyPage.concreteMethodology}
        </p>
        <p class="text-xs text-muted">
          <span class="font-semibold text-ink">{t.methodologyPage.referenceLabel}</span> {t.methodologyPage.concreteReference}
        </p>
      </div>

      <!-- 2. Gravel Base -->
      <div class="space-y-4 border-t border-hairline pt-8">
        <h2 class="text-lg font-bold text-ink">2. {t.methodologyPage.gravelTitle}</h2>
        <p>
          <strong>{t.methodologyPage.methodologyLabel}</strong> {t.methodologyPage.gravelMethodology}
        </p>
        <p class="text-xs text-muted">
          <span class="font-semibold text-ink">{t.methodologyPage.referenceLabel}</span> {t.methodologyPage.gravelReference}
        </p>
      </div>

      <!-- 3. Drywall -->
      <div class="space-y-4 border-t border-hairline pt-8">
        <h2 class="text-lg font-bold text-ink">3. {t.methodologyPage.drywallTitle}</h2>
        <p>
          <strong>{t.methodologyPage.methodologyLabel}</strong> {t.methodologyPage.drywallMethodology}
        </p>
        <p class="text-xs text-muted">
          <span class="font-semibold text-ink">{t.methodologyPage.referenceLabel}</span> {t.methodologyPage.drywallReference}
        </p>
      </div>

      <!-- 4. Framing -->
      <div class="space-y-4 border-t border-hairline pt-8">
        <h2 class="text-lg font-bold text-ink">4. {t.methodologyPage.framingTitle}</h2>
        <p>
          <strong>{t.methodologyPage.methodologyLabel}</strong> {t.methodologyPage.framingMethodology}
        </p>
        <p class="text-xs text-muted">
          <span class="font-semibold text-ink">{t.methodologyPage.referenceLabel}</span> {t.methodologyPage.framingReference}
        </p>
      </div>

      <!-- 5. Rebar Grid -->
      <div class="space-y-4 border-t border-hairline pt-8">
        <h2 class="text-lg font-bold text-ink">5. {t.methodologyPage.rebarTitle}</h2>
        <p>
          <strong>{t.methodologyPage.methodologyLabel}</strong> {t.methodologyPage.rebarMethodology}
        </p>
        <p class="text-xs text-muted">
          <span class="font-semibold text-ink">{t.methodologyPage.referenceLabel}</span> {t.methodologyPage.rebarReference}
        </p>
      </div>

    </div>
  </section>
</BaseLayout>
