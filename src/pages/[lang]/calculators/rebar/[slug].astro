---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import RebarCalculator from '../../../../components/RebarCalculator';
import ToolGuideSection from '../../../../components/ToolGuideSection.astro';
import { getRebarPseoPages, type PseoPageData } from '../../../../data/pseo/pseoMatrix';
import { SUPPORTED_LOCALES, LOCALES, getTranslations, getLocalizedPath, type SupportedLocale } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const NON_DEFAULT_LOCALES = SUPPORTED_LOCALES.filter((l) => l !== 'en');
  const pages = getRebarPseoPages();
  const paths = [];

  for (const lang of NON_DEFAULT_LOCALES) {
    for (const page of pages) {
      paths.push({
        params: { lang, slug: page.slug },
        props: { pageData: page }
      });
    }
  }

  return paths;
}

interface Props {
  pageData: PseoPageData;
}

const { lang } = Astro.params;
const { pageData } = Astro.props;
const activeLang = (lang || 'es') as SupportedLocale;
const t = getTranslations(activeLang);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": pageData.metaTitle,
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication"
    },
    {
      "@type": "FAQPage",
      "mainEntity": pageData.faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={`${pageData.slug} | ${t.nav.rebar}`}
  description={pageData.metaDescription}
  jsonLd={jsonLd}
  lang={activeLang}
>
  <div class="bg-canvas border-b border-hairline py-10 transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex text-xs text-muted mb-4 gap-2">
        <a href={getLocalizedPath('/', activeLang)} class="hover:text-ink">{t.common.home}</a>
        <span>/</span>
        <a href={getLocalizedPath('/calculators/rebar-calculator', activeLang)} class="hover:text-ink">{t.nav.rebar}</a>
        <span>/</span>
        <span class="text-brand-accent font-semibold">{pageData.slug}</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight mb-3 max-w-4xl">
        {pageData.h1Title}
      </h1>
      <p class="text-sm text-body leading-relaxed max-w-3xl mb-4">
        {pageData.metaDescription}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-12">
    <RebarCalculator
      client:load
      initialLength={pageData.inputs.length}
      initialWidth={pageData.inputs.width}
      initialRebarSize={pageData.inputs.rebarSize}
      initialIsMetric={LOCALES[activeLang].isMetricDefault}
    />

    <ToolGuideSection slug="rebar-calculator" />
  </div>
</BaseLayout>
