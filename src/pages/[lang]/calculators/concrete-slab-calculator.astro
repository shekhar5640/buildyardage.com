---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConcreteSlabCalculator from '../../../components/ConcreteSlabCalculator';
import ToolGuideSection from '../../../components/ToolGuideSection.astro';
import { SUPPORTED_LOCALES, getTranslations, LOCALES, type SupportedLocale } from '../../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((l) => l !== 'en').map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params;
const activeLang = (lang || 'es') as SupportedLocale;
const t = getTranslations(activeLang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `${t.nav.concreteSlab} - Build Yardage`,
  "url": `https://buildyardage.com/${activeLang}/calculators/concrete-slab-calculator`,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All"
};
---

<BaseLayout
  title={`${t.nav.concreteSlab} | Build Yardage`}
  description={t.landing.pillars.concreteSlab}
  jsonLd={jsonLd}
  lang={activeLang}
>
  <section class="no-print print:hidden bg-canvas border-b border-hairline transition-colors duration-200">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-accent/10 text-brand-accent dark:text-indigo-400 text-xs font-semibold mb-4">
          <span class="flex h-2 w-2 rounded-full bg-brand-accent animate-pulse"></span>
          <span>100% Free Contractor Tool</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          {t.nav.concreteSlab}
        </h1>
        <p class="mt-3 text-md text-muted leading-relaxed">
          {t.landing.pillars.concreteSlab}
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <ConcreteSlabCalculator client:load initialIsMetric={LOCALES[activeLang].isMetricDefault} />
    <ToolGuideSection slug="concrete-slab-calculator" />
  </div>
</BaseLayout>
