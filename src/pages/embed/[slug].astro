---
import EmbedLayout from '../../layouts/EmbedLayout.astro';
import ConcreteSlabCalculator from '../../components/ConcreteSlabCalculator';
import ConcreteColumnCalculator from '../../components/ConcreteColumnCalculator';
import GravelCalculator from '../../components/GravelCalculator';
import DrywallCalculator from '../../components/DrywallCalculator';
import FramingCalculator from '../../components/FramingCalculator';
import RebarCalculator from '../../components/RebarCalculator';

export function getStaticPaths() {
  const embedRoutes = [
    { slug: 'concrete-slab', calcSlug: 'concrete-slab-calculator', title: 'Concrete Slab Calculator', component: 'concrete-slab' },
    { slug: 'concrete-slab-calculator', calcSlug: 'concrete-slab-calculator', title: 'Concrete Slab Calculator', component: 'concrete-slab' },
    { slug: 'concrete-column', calcSlug: 'concrete-column-calculator', title: 'Concrete Column Calculator', component: 'concrete-column' },
    { slug: 'concrete-column-calculator', calcSlug: 'concrete-column-calculator', title: 'Concrete Column Calculator', component: 'concrete-column' },
    { slug: 'gravel', calcSlug: 'gravel-driveway-calculator', title: 'Gravel Driveway Calculator', component: 'gravel' },
    { slug: 'gravel-driveway', calcSlug: 'gravel-driveway-calculator', title: 'Gravel Driveway Calculator', component: 'gravel' },
    { slug: 'gravel-driveway-calculator', calcSlug: 'gravel-driveway-calculator', title: 'Gravel Driveway Calculator', component: 'gravel' },
    { slug: 'drywall', calcSlug: 'drywall-calculator', title: 'Drywall Calculator', component: 'drywall' },
    { slug: 'drywall-calculator', calcSlug: 'drywall-calculator', title: 'Drywall Calculator', component: 'drywall' },
    { slug: 'framing', calcSlug: 'framing-calculator', title: 'Framing Calculator', component: 'framing' },
    { slug: 'framing-calculator', calcSlug: 'framing-calculator', title: 'Framing Calculator', component: 'framing' },
    { slug: 'rebar', calcSlug: 'rebar-calculator', title: 'Rebar Calculator', component: 'rebar' },
    { slug: 'rebar-calculator', calcSlug: 'rebar-calculator', title: 'Rebar Calculator', component: 'rebar' },
  ];

  return embedRoutes.map((route) => ({
    params: { slug: route.slug },
    props: { routeData: route }
  }));
}

const { routeData } = Astro.props;
---

<EmbedLayout title={`${routeData.title} Widget | BuildYardage`}>
  <div class="min-h-full w-full p-4 sm:p-6 font-sans">
    {routeData.component === 'concrete-slab' && <ConcreteSlabCalculator isEmbed={true} client:load />}
    {routeData.component === 'concrete-column' && <ConcreteColumnCalculator isEmbed={true} client:load />}
    {routeData.component === 'gravel' && <GravelCalculator isEmbed={true} client:load />}
    {routeData.component === 'drywall' && <DrywallCalculator isEmbed={true} client:load />}
    {routeData.component === 'framing' && <FramingCalculator isEmbed={true} client:load />}
    {routeData.component === 'rebar' && <RebarCalculator isEmbed={true} client:load />}
  </div>
</EmbedLayout>
